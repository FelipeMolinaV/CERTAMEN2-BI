    <DTS:Executable
      DTS:refId="Package\Cerrar Versiones Antiguas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{9F3817C1-04C2-4C96-94A0-24218C7D076F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cerrar Versiones Antiguas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022 CTP2.0; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="UPDATE d&#xA;SET d.fecha_fin = CAST(GETDATE() AS DATE), d.es_vigente = 0&#xA;FROM dbo.DimProducto d&#xA;JOIN stg.Producto s ON s.producto_id = d.producto_id&#xA;WHERE d.es_vigente = 1&#xA;  AND ( d.nombre_producto &lt;&gt; s.nombre_producto&#xA;     OR d.categoria_id   &lt;&gt; s.categoria_id&#xA;     OR d.precio_lista   &lt;&gt; s.precio_lista&#xA;     OR ISNULL(d.descripcion,'') &lt;&gt; ISNULL(s.descripcion,'') );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Insertar Versiones Nuevas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{7BE9716C-756F-4FE4-900D-42A854947871}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insertar Versiones Nuevas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022 CTP2.0; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.DimProducto&#xA;  (producto_id, nombre_producto, descripcion, categoria_id, categoria,&#xA;   precio_lista, rango_precio, fecha_inicio, fecha_fin, es_vigente, fecha_carga)&#xA;SELECT s.producto_id, s.nombre_producto, s.descripcion, s.categoria_id, s.categoria,&#xA;       s.precio_lista, s.rango_precio,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM dbo.DimProducto x WHERE x.producto_id = s.producto_id)&#xA;            THEN CAST(GETDATE() AS DATE) ELSE '1900-01-01' END,&#xA;       '9999-12-31', 1, GETDATE()&#xA;FROM stg.Producto s&#xA;LEFT JOIN dbo.DimProducto d ON d.producto_id = s.producto_id AND d.es_vigente = 1&#xA;WHERE d.sk_producto IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
