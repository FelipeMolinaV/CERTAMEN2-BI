                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT e.empleado_id, e.nombre, e.appaterno AS apellido_paterno,
       e.apmaterno AS apellido_materno, e.cargo_id, c.nombre AS cargo,
       e.fecha_contrato, e.sueldo_base
FROM empleados e
INNER JOIN cargos c ON c.cargo_id = e.cargo_id</property>
