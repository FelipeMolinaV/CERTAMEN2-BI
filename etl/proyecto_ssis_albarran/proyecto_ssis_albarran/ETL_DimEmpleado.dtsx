      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="UPDATE d&#xA;SET d.antiguedad_anios = s.antiguedad_anios,&#xA;    d.rango_antiguedad = s.rango_antiguedad&#xA;FROM dbo.DimEmpleado d&#xA;JOIN stg.Empleado s ON s.empleado_id = d.empleado_id&#xA;WHERE d.es_vigente = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
