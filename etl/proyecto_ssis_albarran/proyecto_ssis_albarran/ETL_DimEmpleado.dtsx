    <DTS:Executable
      DTS:refId="Package\Cerrar Versiones Empleado"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{8740A2DB-CBBE-45CA-BB96-969E70873F5E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Cerrar Versiones Empleado"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022 CTP2.0; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="UPDATE d&#xA;SET d.fecha_fin = CAST(GETDATE() AS DATE), d.es_vigente = 0&#xA;FROM dbo.DimEmpleado d&#xA;JOIN stg.Empleado s ON s.empleado_id = d.empleado_id&#xA;WHERE d.es_vigente = 1&#xA;  AND ( d.cargo_id &lt;&gt; s.cargo_id&#xA;     OR d.sueldo_base &lt;&gt; s.sueldo_base );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Insertar Versiones Empleado"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{3B7040DC-6708-4EDD-B8AD-E5D96A13EFFD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insertar Versiones Empleado"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022 CTP2.0; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.DimEmpleado&#xA;  (empleado_id, nombre_completo, cargo_id, cargo, sueldo_base,&#xA;   antiguedad_anios, rango_antiguedad, fecha_inicio, fecha_fin, es_vigente, fecha_carga)&#xA;SELECT s.empleado_id, s.nombre_completo, s.cargo_id, s.cargo, s.sueldo_base,&#xA;       s.antiguedad_anios, s.rango_antiguedad,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM dbo.DimEmpleado x WHERE x.empleado_id = s.empleado_id)&#xA;            THEN CAST(GETDATE() AS DATE) ELSE '1900-01-01' END,&#xA;       '9999-12-31', 1, GETDATE()&#xA;FROM stg.Empleado s&#xA;LEFT JOIN dbo.DimEmpleado d ON d.empleado_id = s.empleado_id AND d.es_vigente = 1&#xA;WHERE d.sk_empleado IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Truncar Staging Empleado"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
