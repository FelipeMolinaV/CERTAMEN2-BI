                          description="Derived Column Expression"
                          name="Expression">#{Package\Cargar Stating Empleado\Derived Column.Outputs[Derived Column Output].Columns[antiguedad_anios]} &lt;= 2 ? "0-2" : (#{Package\Cargar Stating Empleado\Derived Column.Outputs[Derived Column Output].Columns[antiguedad_anios]} &lt;= 5 ? "3-5" : (#{Package\Cargar Stating Empleado\Derived Column.Outputs[Derived Column Output].Columns[antiguedad_anios]} &lt;= 10 ? "6-10" : "Más de 10 años"))</property>
