                          name="FriendlyExpression">antiguedad_anios &lt;= 2 ? "0-2" : (antiguedad_anios &lt;= 5 ? "3-5" : (antiguedad_anios &lt;= 10 ? "6-10" : "Más de 10 años"))</property>
