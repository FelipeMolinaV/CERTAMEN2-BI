                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">[DATEDIFF]("yy",#{Package\Cargar Stating Empleado\OLE DB Source.Outputs[OLE DB Source Output].Columns[fecha_contrato]},[GETDATE]()) - ([DATEADD]("yy",[DATEDIFF]("yy",#{Package\Cargar Stating Empleado\OLE DB Source.Outputs[OLE DB Source Output].Columns[fecha_contrato]},[GETDATE]()),#{Package\Cargar Stating Empleado\OLE DB Source.Outputs[OLE DB Source Output].Columns[fecha_contrato]}) &gt; [GETDATE]() ? 1 : 0)</property>
