                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">DATEDIFF("yy",fecha_contrato,GETDATE()) - (DATEADD("yy",DATEDIFF("yy",fecha_contrato,GETDATE()),fecha_contrato) &gt; GETDATE() ? 1 : 0)</property>
