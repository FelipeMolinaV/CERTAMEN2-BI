                          description="Derived Column Expression"
                          name="Expression">[TRIM](#{Package\Cargar Stating Empleado\OLE DB Source.Outputs[OLE DB Source Output].Columns[nombre]}) + " " + [TRIM](#{Package\Cargar Stating Empleado\OLE DB Source.Outputs[OLE DB Source Output].Columns[apellido_paterno]}) + " " + [TRIM](#{Package\Cargar Stating Empleado\OLE DB Source.Outputs[OLE DB Source Output].Columns[apellido_materno]})</property>
