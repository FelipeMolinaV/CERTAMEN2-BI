      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Limpieza de Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE stg.stg_FactVentas;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Validar y Promover a FactVentas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{50D07DAE-C368-4600-96A7-A2BBC2DF804F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Validar y Promover a FactVentas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="USE DW_Albarran;&#xA;GO&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;-- 1. Control de Integridad: Abortar si llegaron claves foráneas huérfanas (NULL)&#xA;IF EXISTS (&#xA;    SELECT 1 FROM dbo.stg_FactVentas &#xA;    WHERE sk_tiempo IS NULL &#xA;       OR sk_cliente IS NULL &#xA;       OR sk_producto IS NULL &#xA;       OR sk_empleado IS NULL &#xA;       OR sk_sucursal IS NULL &#xA;       OR sk_tipo_documento IS NULL&#xA;)&#xA;BEGIN&#xA;    ROLLBACK TRANSACTION;&#xA;    RAISERROR('Error: Se detectaron claves foráneas huérfanas (NULL) en stg_FactVentas. Carga cancelada.', 16, 1);&#xA;    RETURN;&#xA;END;&#xA;&#xA;-- 2. Control de Reglas de Negocio: Abortar si hay cantidades o montos negativos&#xA;IF EXISTS (&#xA;    SELECT 1 FROM dbo.stg_FactVentas &#xA;    WHERE cantidad &lt;= 0 OR monto_bruto &lt; 0 OR monto_neto &lt; 0&#xA;)&#xA;BEGIN&#xA;    ROLLBACK TRANSACTION;&#xA;    RAISERROR('Error: Se detectaron importes o cantidades incoherentes en stg_FactVentas. Carga cancelada.', 16, 1);&#xA;    RETURN;&#xA;END;&#xA;&#xA;-- 3. Promoción segura a FactVentas (Evitando duplicar ventas ya cargadas)&#xA;INSERT INTO dbo.FactVentas (&#xA;    sk_tiempo, sk_cliente, sk_producto, sk_empleado, sk_sucursal, sk_tipo_documento,&#xA;    venta_id, numero_documento, cantidad, precio_unitario, descuento_original,&#xA;    monto_bruto, monto_descuento, monto_neto, fecha_carga&#xA;)&#xA;SELECT &#xA;    s.sk_tiempo, s.sk_cliente, s.sk_producto, s.sk_empleado, s.sk_sucursal, s.sk_tipo_documento,&#xA;    s.venta_id, s.numero_documento, s.cantidad, s.precio_unitario, s.descuento_original,&#xA;    s.monto_bruto, s.monto_descuento, s.monto_neto, GETDATE()&#xA;FROM dbo.stg_FactVentas s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dbo.FactVentas f &#xA;    WHERE f.venta_id = s.venta_id &#xA;      AND f.sk_producto = s.sk_producto&#xA;);&#xA;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
