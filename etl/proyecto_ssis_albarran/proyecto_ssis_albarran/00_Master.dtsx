    <DTS:Executable
      DTS:refId="Package\SQL - Limpieza de Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{2CA9E110-E636-46C3-8C90-F6CC0CE9A0D8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Limpieza de Staging"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.stg_FactVentas;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL - Validar y Promover a FactVentas"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{50D07DAE-C368-4600-96A7-A2BBC2DF804F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Validar y Promover a FactVentas"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7DB5BEC9-32D3-4D30-8AF5-013658F85232}"
          SQLTask:SqlStatementSource="&#xA;BEGIN TRANSACTION;&#xA;&#xA;-- 1. Control de integridad: claves foráneas NULL&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.stg_FactVentas&#xA;    WHERE sk_tiempo IS NULL&#xA;       OR sk_cliente IS NULL&#xA;       OR sk_producto IS NULL&#xA;       OR sk_empleado IS NULL&#xA;       OR sk_sucursal IS NULL&#xA;       OR sk_tipo_documento IS NULL&#xA;)&#xA;BEGIN&#xA;    ROLLBACK TRANSACTION;&#xA;    RAISERROR(&#xA;        'Error: Se detectaron claves foráneas huérfanas (NULL). Carga cancelada.',&#xA;        16, 1&#xA;    );&#xA;    RETURN;&#xA;END;&#xA;&#xA;-- 2. Control de reglas de negocio&#xA;IF EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.stg_FactVentas&#xA;    WHERE cantidad &lt;= 0&#xA;       OR monto_bruto &lt; 0&#xA;       OR monto_neto &lt; 0&#xA;)&#xA;BEGIN&#xA;    ROLLBACK TRANSACTION;&#xA;    RAISERROR(&#xA;        'Error: Se detectaron importes o cantidades incoherentes. Carga cancelada.',&#xA;        16, 1&#xA;    );&#xA;    RETURN;&#xA;END;&#xA;&#xA;-- 3. Promoción a FactVentas evitando duplicados&#xA;INSERT INTO dbo.FactVentas (&#xA;    sk_tiempo, sk_cliente, sk_producto, sk_empleado,&#xA;    sk_sucursal, sk_tipo_documento,&#xA;    venta_id, numero_documento, cantidad, precio_unitario,&#xA;    descuento_original, monto_bruto, monto_descuento,&#xA;    monto_neto, fecha_carga&#xA;)&#xA;SELECT&#xA;    s.sk_tiempo, s.sk_cliente, s.sk_producto, s.sk_empleado,&#xA;    s.sk_sucursal, s.sk_tipo_documento,&#xA;    s.venta_id, s.numero_documento, s.cantidad,&#xA;    s.precio_unitario, s.descuento_original,&#xA;    s.monto_bruto, s.monto_descuento, s.monto_neto,&#xA;    GETDATE()&#xA;FROM dbo.stg_FactVentas AS s&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.FactVentas AS f&#xA;    WHERE f.venta_id = s.venta_id&#xA;      AND f.sk_producto = s.sk_producto&#xA;);&#xA;&#xA;COMMIT TRANSACTION;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
