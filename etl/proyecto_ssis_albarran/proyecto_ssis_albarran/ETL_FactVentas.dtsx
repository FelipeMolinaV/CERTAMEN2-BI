                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Comando SQL para ejecutar."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT v.venta_id, v.fecha, v.vendedor_id, v.cliente_id, v.sucursal_id,
       v.tipo_documento, v.numero_documento,
       d.producto_id, d.cantidad, d.precio_unitario, d.descuento
FROM ventas v
INNER JOIN detalle_ventas d ON d.venta_id = v.venta_id
WHERE v.venta_id &gt; ?</property>
