  <Source dwd:design-time-name="aeb652af-e668-4317-a531-12f5ccd0128a">
    <DataSourceViewID>DW Albarran</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="8e58868f-489d-476b-a596-5ed12d1f0b72">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T03:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T03:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Ticket Promedio]
 AS IIF([Measures].[Nro Ventas] = 0, NULL, [Measures].[Monto Neto] / [Measures].[Nro Ventas]), 
FORMAT_STRING = "Currency", 
NON_EMPTY_BEHAVIOR = { [Nro Ventas] }, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Participacion Categoria]
 AS IIF(([Measures].[Monto Neto], [Dim Producto].[Categoria].[All]) = 0, NULL, [Measures].[Monto Neto] / ([Measures].[Monto Neto], [Dim Producto].[Categoria].[All])), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Promedio Ventas Vendedor]
 AS IIF(COUNT(EXISTING [Dim Empleado].[Empleado].[Empleado].Members) = 0, NULL, [Measures].[Monto Neto] / COUNT(EXISTING [Dim Empleado].[Empleado].[Empleado].Members)), 
FORMAT_STRING = "Currency", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="89a47798-cdf1-45cf-a354-c0738ef8669e">
      <ID>KPI</ID>
      <Name>KPI Ventas Mensuales</Name>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Monto Neto]</Value>
      <Goal>([Measures].[Monto Neto], ParallelPeriod([Dim Tiempo].[Jerarquía].[Mes], 1, [Dim Tiempo].[Jerarquía].CurrentMember)) * 1.05</Goal>
      <Status>CASE
  WHEN KpiValue("KPI Ventas Mensuales") &gt;= KpiGoal("KPI Ventas Mensuales") THEN 1
  WHEN KpiValue("KPI Ventas Mensuales") &gt;= KpiGoal("KPI Ventas Mensuales") * 0.90 THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="4688b6a9-5681-4f1d-8a45-bd916d423a21">
      <ID>KPI 1</ID>
      <Name>KPI Ticket Promedio</Name>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Ticket Promedio]</Value>
      <Goal>150000</Goal>
      <Status>CASE
  WHEN KpiValue("KPI Ticket Promedio") &gt;= KpiGoal("KPI Ticket Promedio") THEN 1
  WHEN KpiValue("KPI Ticket Promedio") &gt;= KpiGoal("KPI Ticket Promedio") * 0.85 THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="56912d31-aea2-463e-9eb2-81f6507e7b6b">
      <ID>KPI 2</ID>
      <Name>KPI Desempeno Vendedor</Name>
      <AssociatedMeasureGroupID>Fact Ventas</AssociatedMeasureGroupID>
      <Value>[Measures].[Promedio Ventas Vendedor]</Value>
      <Goal>5000000</Goal>
      <Status>CASE
  WHEN KpiValue("KPI Desempeno Vendedor") &gt;= KpiGoal("KPI Desempeno Vendedor") THEN 1
  WHEN KpiValue("KPI Desempeno Vendedor") &gt;= KpiGoal("KPI Desempeno Vendedor") * 0.80 THEN 0
  ELSE -1
END</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>